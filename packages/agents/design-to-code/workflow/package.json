{
  "name": "@appvelocity/agent-design-to-code-workflow",
  "version": "0.1.0",
  "description": "DesignToCodeAgent – LangGraph multi-agent workflow orchestration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@appvelocity/shared-core": "workspace:*",
    "@appvelocity/agent-design-to-code-core": "workspace:*",
    "@appvelocity/agent-design-to-code-generators": "workspace:*",
    "@langchain/langgraph": "^0.2.0",
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.5",
    "vitest": "^1.6.0"
  }
}
